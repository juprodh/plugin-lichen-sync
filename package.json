{
	"name": "lichen-sync",
	"type": "module",
	"private": true,
	"license": "MIT",
	"scripts": {
		"bundle": "bun build src/main.ts --outfile main.js --format cjs --target browser --external obsidian --external electron --external '@codemirror/*' --external '@lezer/*'",
		"build": "bun run bundle --minify",
		"dev": "bun run bundle --watch --sourcemap=inline",
		"test": "bun test",
		"lint": "biome check && eslint --max-warnings 0 .",
		"lint:fix": "biome check --write && eslint --fix --max-warnings 0 .",
		"typecheck": "tsc && tsc -p tests",
		"knip": "knip && knip --production"
	},
	"dependencies": {
		"@atcute/client": "^5.1.2",
		"@atcute/identity-resolver": "^2.0.3",
		"@atcute/lexicons": "^2.1.1",
		"@atcute/oauth-node-client": "^2.0.1",
		"@atcute/tid": "^1.1.4",
		"@lichen-wiki/client": "^0.2.0",
		"diff-match-patch": "^1.0.5"
	},
	"devDependencies": {
		"@atcute/atproto": "^4.0.4",
		"@biomejs/biome": "^2.6.7",
		"@types/bun": "^1.4.4",
		"@types/diff-match-patch": "^1.0.36",
		"eslint": "^10.15.0",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"knip": "^6.45.1",
		"obsidian": "^1.14.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2"
	}
}
