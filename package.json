{
	"name": "lichen-sync",
	"type": "module",
	"private": true,
	"license": "MIT",
	"scripts": {
		"bundle": "bun build src/main.ts --outfile main.js --format cjs --target browser --external obsidian --external electron --external '@codemirror/*' --external '@lezer/*'",
		"build": "bun run bundle --minify",
		"dev": "bun run bundle --watch --sourcemap=inline",
		"test": "bun test",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"typecheck": "tsc && tsc -p tests",
		"knip": "knip && knip --production"
	},
	"dependencies": {
		"@atcute/atproto": "^4.0.4",
		"@atcute/client": "^5.1.2",
		"@atcute/lexicons": "^2.1.1",
		"@atcute/tid": "^1.1.4",
		"@lichen/client": "file:../lichen-repo/packages/client",
		"diff-match-patch": "^1.0.5",
		"obsidian": "^1.14.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@types/bun": "^1.4.4",
		"@types/diff-match-patch": "^1.0.36",
		"knip": "^6.45.1",
		"typescript": "^7.0.2"
	}
}
